{
  "name": "wrfxweb",
  "private": true,
  "version": "0.0.0",
  "description": "A visualization server for the outputs of fire-weather model wrf-sfire as generated by *wrfxpy*",
  "license": "SJSU",
  "devDependencies": {
    "@babel/cli": "^7.12.10",
    "@babel/core": "^7.12.10",
    "@babel/plugin-transform-runtime": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "http-server": "^14.1.1",
    "jasmine-core": "^2.3.4",
    "jest": "^29.7.0"
  },
  "scripts": {
    "client": "cd python/clientServer && ../venv/bin/flask --app __init__ run --debug --port 8000",
    "external-server": "cd python/externalService && ../venv/bin/flask --app __init__ run --debug --port 8001",
    "worker-queue": "cd python/workerQueue && ../venv/bin/flask --app __init__ run --debug --port 8002",
    "worker": "cd python/worker && ../venv/bin/flask --app __init__ run --debug --port 8003",
    "test": "jest --silent"
  }
}
